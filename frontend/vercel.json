{
  "version": 2,
  "name": "angular-portfolio-frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "angular",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
